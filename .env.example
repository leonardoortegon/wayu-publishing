# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Resend → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxx

# Must use an address on a domain verified in Resend (Domains → wayupublishing.com).
# Example after DNS verification:
RESEND_FROM="WAYU Publishing <hello@wayupublishing.com>"

# Where inquiry emails are delivered (can be the same inbox or a team alias).
INQUIRY_TO=hello@wayupublishing.com
